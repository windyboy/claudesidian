{
  "$schema": "https://opencode.ai/config.json",

  // Permission system (global and agent-specific)
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "npm install": "allow",
      "pnpm install": "allow",
      "pnpm test": "allow",
      "pnpm lint": "allow",
      "pnpm format": "allow",
      "pnpm *": "allow",
      "ls": "allow",
      "cat": "allow",
      "find": "allow",
      "date": "allow",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      ".env": "deny",
      "**/.env": "deny",
    },
    "write": "allow",
    "edit": {
      "*": "deny",
      "package.json": "allow",
      "*.md": "allow",
      "*.mjs": "allow",
      "*.sh": "allow",
      "*.json": "allow",
    },
    "bash:git": {
      "*": "allow",
    },
    "bash:pnpm": {
      "*": "allow",
    },
  },

  // Plugin system (singular key, not "plugins")
  "plugin": ["session-hooks"],

  // MCP server configuration
  "mcp": {
    "gemini-vision": {
      "type": "local",
      "command": ["node", ".claude/mcp-servers/gemini-vision.mjs"],
      "environment": {
        "GEMINI_API_KEY": "{env:GEMINI_API_KEY}",
      },
      "enabled": true,
    },
  },

  // Agent-specific overrides
  "agent": {
    "bootstrap": {
      "description": "Full-access bootstrap agent for setup and initialization",
      "permission": {
        "bash": "allow",
        "write": "allow",
        "edit": "allow",
        "read": "allow",
      },
    },
    "thinking-partner": {
      "description": "Read-only thinking assistant for collaborative exploration",
      "permission": {
        "bash": "ask",
        "write": "deny",
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "read": "allow",
      },
    },
    "research-assistant": {
      "description": "Research agent with web access for information gathering",
      "permission": {
        "bash": "ask",
        "write": "allow",
        "edit": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "read": "allow",
      },
    },
    "assistant": {
      "description": "Standard assistant for daily tasks and workflows",
      "permission": {
        "bash": "ask",
        "write": "allow",
        "edit": "allow",
        "webfetch": "ask",
        "read": "allow",
      },
    },
    "read-only": {
      "description": "Analysis-only agent with minimal permissions",
      "permission": {
        "bash": "deny",
        "write": "deny",
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "read": "allow",
      },
    },
  },

  // Command directory
  "command": ".opencode/command",
}
